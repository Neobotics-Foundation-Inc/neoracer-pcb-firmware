# ESP32-S3-WROOM-1U-N16R8
CONFIG_IDF_TARGET="esp32s3"

# Verified flashing profile: 16MB image header, DIO, 80MHz
# Physical module: 16MB Flash + 8MB Octal PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# OTA app layout for serial firmware updates
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_ota.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# PSRAM: 8MB Octal
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# USB CDC protocol port (UART0 is used for SBUS)
CONFIG_OSCORE_USB_BACKEND_TINYUSB=y
CONFIG_OSCORE_USB_PRODUCT_STRING="Neoracer V1"
CONFIG_OSCORE_USB_MANUFACTURER_STRING="Seeed Studio & OSRBOT"
CONFIG_OSCORE_USB_SERIAL_STRING="OSRCOREV01"
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=512
CONFIG_TINYUSB_CDC_TX_BUFSIZE=512
CONFIG_TINYUSB_CDC_EP_BUFSIZE=512
CONFIG_ESPTOOLPY_MONITOR_BAUD=460800

# NVS
CONFIG_NVS_ENCRYPTION=n

# FreeRTOS tick rate
CONFIG_FREERTOS_HZ=1000

# Chassis physical parameters
CONFIG_OSCORE_ENCODER_A_GPIO=3
CONFIG_OSCORE_ENCODER_B_GPIO=9
CONFIG_OSCORE_ENCODER_PPR=1024
CONFIG_OSCORE_GEAR_RATIO_MILLI=10550
CONFIG_OSCORE_WHEEL_RADIUS_UM=42500
CONFIG_OSCORE_SPEED_CALC_INTERVAL_MS=20

# Compiler: C++17
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_STACK_CHECK_MODE_NONE=y
